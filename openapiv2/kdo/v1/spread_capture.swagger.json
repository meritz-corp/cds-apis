    },
    "commonOrderSide": {
      "type": "string",
      "enum": [
        "ORDER_SIDE_UNSPECIFIED",
        "ORDER_SIDE_BID",
        "ORDER_SIDE_ASK"
      ],
      "default": "ORDER_SIDE_UNSPECIFIED",
      "description": "- ORDER_SIDE_BID: 매수\n - ORDER_SIDE_ASK: 매도",
      "title": "주문 방향"
    },
    "commonPdfDecomposeHedgePricing": {
      "type": "object",
      "description": "PDF 재귀 분해 헷지 가격 산출 (파라미터 없음)\nNAV 계산은 Etf.decomposed_constituents를 PdfNavHedge와 동일 공식으로 적용."
    },
    "commonPdfNavHedgePricing": {
      "type": "object",
      "title": "분해 헷지 가격 산출 (추가 파라미터 없음)"
    },
    "lpFillStat": {
      "type": "object",
      "properties": {
        "symbol": {
          "type": "string"
        },
        "buyFilledQuantity": {
          "type": "string",
          "format": "int64"
        },
        "buyAvgPrice": {
          "type": "number",
          "format": "double"
        },
        "sellFilledQuantity": {
          "type": "string",
          "format": "int64"
        },
        "sellAvgPrice": {
          "type": "number",
          "format": "double"
        }
      },
      "description": "한 종목(ETF 또는 헷지 선물)의 매수/매도 체결 요약.\navg_price 는 서버에서 total_amount/qty 로 산출된 값."
    },
    "order_logLastAskBidTpCode": {
      "type": "string",
      "enum": [
        "LAST_ASK_BID_TP_CODE_UNSPECIFIED",
        "TAKE",
        "MAKE",
        "SINGLE_PRICE"
      ],
      "default": "LAST_ASK_BID_TP_CODE_UNSPECIFIED",
      "description": "- SINGLE_PRICE: 단일가(동시호가/시가·종가/VI/시간외) 체결",
      "title": "매수도체결구분 (make/take)"
    },
    "protobufAny": {
      "type": "object",
      "properties": {
        "@type": {
          "type": "string"
        }
      },
      "additionalProperties": {}
    },
    "rpcStatus": {
      "type": "object",
      "properties": {
        "code": {
          "type": "integer",
          "format": "int32"
        },
        "message": {
          "type": "string"
        },
        "details": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/protobufAny"
          }
        }
      }
    },
    "spread_captureListSpreadCaptureCyclesResponse": {
      "type": "object",
      "properties": {
