    "/v1/spread_captures/cycles": {
      "get": {
        "summary": "포지션 사이클 목록 — 순노출이 0 에서 생겨(open) 다시 0 이 될 때(close)까지의 체결·청산 주문 경과와 그때 공정가. 최근에 저장된 것부터.\n사이클은 닫힐 때(또는 노출을 남긴 채 실행이 끝날 때) 저장된다. 이 서버에서 아직 열려 있는 사이클은 첫 페이지 맨 앞에 붙는다(page_size 밖).",
        "operationId": "SpreadCaptureService_ListSpreadCaptureCycles",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/spread_captureListSpreadCaptureCyclesResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "etfSymbol",
            "description": "비우면 전체",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "fundCode",
            "description": "비우면 전체",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "date",
            "description": "사이클을 연 영업일 (YYYYMMDD, KST). 미지정 시 날짜 제한 없음",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int64"
          },
          {
            "name": "pageSize",
            "description": "페이지 크기 (기본: 20, 최대: 100)",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int32"
          },
          {
            "name": "pageToken",
            "description": "이전 응답의 next_page_token 을 그대로 전달. 최초 조회는 미지정",
            "in": "query",
            "required": false,
            "type": "string"
          }
        ],
        "tags": [
          "SpreadCaptureService"
        ]
      }
    },
    "/v1/spread_captures/statuses": {
      "get": {
        "summary": "오늘 시작한 스프레드 캡처 상태 목록",
