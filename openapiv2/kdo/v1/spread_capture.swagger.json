        "prevIndex": {
          "type": "string"
        }
      }
    },
    "commonIndexTrackingHedgePricing": {
      "type": "object",
      "title": "선물 헷지 가격 산출"
    },
    "commonLeverageFuturePricing": {
      "type": "object",
      "properties": {
        "prevIndex": {
          "type": "number",
          "format": "double",
          "title": "기초지수 전일종가"
        },
        "prevFuture": {
          "type": "number",
          "format": "double",
