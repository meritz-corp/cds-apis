        ]
      }
    },
    "/v1/spread_captures/{etfSymbol}/{fundCode}:start": {
      "post": {
        "summary": "스프레드 캡처 시작 — 08:28 전이면 08:28 에 장전 주문을 보내고, 08:28 ~ 시가 결정 전이면 바로 보낸다(08:30 이후분은 바로 동시호가 접수).\n시가 결정 뒤 시작하면 장전 주문 없이 선물 기준 목표 오더북을 바로 깐다. 15:19:00 이후이거나 이미 실행 중이면 FAILED_PRECONDITION.\n주문자 식별정보는 start 한 사람 기준.",
        "operationId": "SpreadCaptureService_StartSpreadCapture",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/spread_captureSpreadCaptureStatus"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "etfSymbol",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "fundCode",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object"
            }
          }
        ],
        "tags": [
          "SpreadCaptureService"
        ]
      }
    },
    "/v1/spread_captures/{etfSymbol}/{fundCode}:stop": {
      "post": {
        "summary": "스프레드 캡처 정지 — 살아 있는 주문을 전부 취소한다. 노출은 청산하지 않는다(상태의 net_quantity 참고).\n08:30 전 FEP 가 보관 중인 주문은 08:30 에 접수되는 대로 취소한다.",
        "operationId": "SpreadCaptureService_StopSpreadCapture",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/spread_captureSpreadCaptureStatus"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "etfSymbol",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "fundCode",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object"
            }
          }
        ],
        "tags": [
          "SpreadCaptureService"
        ]
      }
    },
    "/v1/spread_captures/{spreadCapture.etfSymbol}/{spreadCapture.fundCode}": {
      "post": {
        "summary": "스프레드 캡처 설정 저장 — 없으면 만들고 있으면 덮어쓴다. 실행 중이면 basis·adjustment·offset·임계·되돌림 여유·청산 시작 임계·청산 정정 임계·최대 순노출만\n바꿀 수 있고 실행에 바로 반영된다. 실행 중에 그 밖의 값(장전 시작가·depth·수량·호가단위·pricing 종류)이 저장값과 다르면 FAILED_PRECONDITION.",
        "operationId": "SpreadCaptureService_UpdateSpreadCapture",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/spread_captureSpreadCapture"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "spreadCapture.etfSymbol",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "spreadCapture.fundCode",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "spreadCapture": {
                  "type": "object",
                  "properties": {
                    "bidPrice": {
                      "type": "string",
                      "format": "int64",
                      "title": "장전(08:28) 매수 시작가(원). 0 이면 장전 매수 안 냄 — 시가 직후 정렬 때 목표 오더북대로 새로 낸다"
                    },
                    "askPrice": {
                      "type": "string",
                      "format": "int64",
                      "title": "장전(08:28) 매도 시작가(원). 0 이면 장전 매도 안 냄"
                    },
                    "depth": {
                      "type": "integer",
                      "format": "int64",
                      "title": "측별 단수 (1~10) — 매수·매도 1호가부터 이만큼 깐다"
                    },
                    "quantity": {
                      "type": "string",
                      "format": "int64",
                      "title": "단별 수량 (매수·매도 공통)"
                    },
                    "tickSize": {
                      "type": "string",
                      "format": "int64",
                      "title": "ETF 호가단위(원) — 단 간격이자 틱 경계 간격"
                    },
                    "pricing": {
                      "$ref": "#/definitions/commonEtfPricing",
                      "title": "공정가 계산 방식 — 선물 하나로 계산하는 FUTURE_BASIS·LEVERAGE_FUTURE·INDEX_TRACKING_HEDGE·PDF_DECOMPOSE_HEDGE 만 허용.\nPDF_DECOMPOSE_HEDGE 는 하위 ETF 까지 분해한 PDF 에 선물이 하나만 남아야 한다(start 때 확인 — 곱버스처럼 추적 선물이 마스터에 없는 ETF 용,\n선물 외 구성종목은 start 때 값으로 고정·basis 미적용). 공정가 = NAV(pricing·basis) + adjustment ∓ 호가단위 × offset"
                    },
                    "bidBasis": {
                      "type": "number",
                      "format": "double",
                      "title": "원"
                    },
                    "askBasis": {
                      "type": "number",
                      "format": "double",
                      "title": "원"
                    },
                    "bidAdjustment": {
                      "type": "number",
                      "format": "double",
                      "title": "원"
                    },
                    "askAdjustment": {
                      "type": "number",
                      "format": "double",
                      "title": "원"
                    },
                    "bidOffset": {
                      "type": "number",
                      "format": "double",
                      "title": "매수 offset (ETF 틱, 소수·음수 가능 — ETF LP EtfLpOffset.bid_offset 과 같은 단위·부호) — 매수 공정가를 호가단위 × 이 값만큼 내린다.\n시장이 NAV 보다 눌려 있으면 매수 +·매도 −, 떠 있으면 매수 −·매도 + 로 같은 크기를 넣어 공정가를 통째로 민다"
                    },
                    "askOffset": {
                      "type": "number",
                      "format": "double",
                      "title": "매도 offset (ETF 틱, 소수·음수 가능 — ETF LP EtfLpOffset.ask_offset 과 같은 단위·부호) — 매도 공정가를 호가단위 × 이 값만큼 올린다.\nbid_offset + ask_offset 은 0 이상이어야 한다. 합만큼 공정가 폭이 넓어져 안전 구간이 남지 않으면 start·실행 중 변경에서 거부한다"
                    },
                    "thresholdTicks": {
                      "type": "number",
                      "format": "double",
                      "title": "임계 (선물 틱, 소수 가능) — 공정가가 틱 경계까지 이만큼 남으면 전환 구간에 들어간다"
                    },
                    "reentryTicks": {
                      "type": "number",
                      "format": "double",
                      "title": "되돌림 여유 (선물 틱, 소수 가능) — 전환 구간에서 원래 안전 구간으로 돌아가려면 경계에서 임계 + 이만큼 멀어져야 한다"
                    },
                    "flattenStartTicks": {
                      "type": "number",
                      "format": "double",
                      "title": "청산 시작 임계 (선물 틱, 소수 가능) — 공정가가 틱 경계까지 이만큼 남으면 불리한 방향 노출 청산을 시작한다(경계 쪽 호가는 임계에서 먼저 비킨다).\n0 이상, 임계 이하. 없으면 임계와 같다(호가를 비킬 때 바로 청산)"
                    },
                    "flattenAmendTicks": {
                      "type": "number",
                      "format": "double",
                      "title": "청산 정정 임계 (선물 틱, 소수 가능) — 전환 구간 청산은 경계 가격 지정가로 내고 남은 수량은 그 가격에 둔다.\n공정가가 그 경계를 이만큼 넘어가면(매도 청산은 아래로, 매수 청산은 위로) 한 호가단위 불리한 가격으로 정정한다.\n0 이상, 임계 + 이 값(원 환산)은 호가단위보다 작아야 한다"
                    },
                    "maxNetQuantity": {
                      "type": "string",
                      "format": "int64",
                      "title": "최대 순노출 (주) — 순노출이 이 이상이면 노출을 키우는 쪽의 빈 단을 다시 채우지 않는다"
                    },
                    "updateTime": {
                      "type": "string",
                      "format": "date-time",
                      "readOnly": true
                    }
                  },
                  "title": "update_time 은 무시(서버가 채움)"
                }
              }
            }
          }
        ],
        "tags": [
          "SpreadCaptureService"
        ]
      }
    }
  },
  "definitions": {
    "commonEtfPricing": {
      "type": "object",
      "properties": {
        "pdfNavHedge": {
