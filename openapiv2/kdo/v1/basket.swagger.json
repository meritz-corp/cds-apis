    "basketBasketExecutionActionType": {
      "type": "string",
      "enum": [
        "BASKET_EXECUTION_ACTION_TYPE_UNSPECIFIED",
        "BASKET_EXECUTION_ACTION_TYPE_NEW",
        "BASKET_EXECUTION_ACTION_TYPE_AMEND",
        "BASKET_EXECUTION_ACTION_TYPE_CANCEL"
