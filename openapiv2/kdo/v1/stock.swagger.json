{
  "swagger": "2.0",
  "info": {
    "title": "kdo/v1/stock.proto",
    "version": "version not set"
  },
  "tags": [
    {
      "name": "StockService"
    }
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/v1/stocks": {
      "get": {
        "summary": "주식 목록 조회",
        "operationId": "StockService_ListStocks",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/stockListStocksResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "pageSize",
            "description": "페이지 크기 (optional)",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int32"
          },
          {
            "name": "pageToken",
            "description": "페이지 토큰 (optional)",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "filter",
            "description": "필터링 조건 (optional, AIP-160)\n\nAvailable Fields (아래 3개 외 필드는 INVALID_ARGUMENT):\n* symbol - 표준코드, 예: \"KR7005930003\"\n* name   - 종목명, 예: \"삼성전자\"\n* code   - 단축코드, 예: \"A005930\"\n\nNOTE: market_type / tradable / short_sellable 은 서버 미구현 — 사용 시 INVALID_ARGUMENT\n\nOperators:\n* `=` 정확일치 (대소문자 구분)\n* `:` 부분일치 (대소문자 무시)\n* 값은 큰따옴표로 감싼다\n\nCombining:\n* AND 만 지원 — OR 는 INVALID_ARGUMENT\n* 같은 필드에 `=` 를 여러 번 주면 그 값들의 OR(IN) 으로 동작\n* 같은 필드에 `=` 와 `:` 를 같이 주면 `=` 가 우선\n* `symbol:\"*\"` 는 해당 필드 무필터 (빈 filter 와 동일)\n\nExamples:\n* symbol = \"KR7005930003\"\n* symbol = \"KR7005930003\" AND symbol = \"KR7000660001\"   // 둘 중 하나\n* code = \"A005930\"\n* name:\"삼성\"",
            "in": "query",
            "required": false,
            "type": "string"
          }
        ],
        "tags": [
          "StockService"
        ]
      }
    },
    "/v1/stocks:tickSize": {
      "get": {
        "operationId": "StockService_GetStockTickSize",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/stockGetStockTickSizeResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "targetPrice",
            "in": "query",
            "required": true,
            "type": "string"
          }
        ],
        "tags": [
          "StockService"
        ]
      }
    },
    "/v1/{stock}": {
      "get": {
        "summary": "단일 주식 조회",
        "operationId": "StockService_GetStock",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/stockStock"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "stock",
            "description": "리소스 이름 (stocks/{code})",
            "in": "path",
            "required": true,
            "type": "string",
            "pattern": "stocks/[^/]+"
          }
        ],
        "tags": [
          "StockService"
        ]
      }
    }
  },
  "definitions": {
    "commonMarketType": {
      "type": "string",
      "enum": [
        "MARKET_TYPE_UNSPECIFIED",
        "MARKET_TYPE_KOSPI",
        "MARKET_TYPE_KOSDAQ",
        "MARKET_TYPE_DERIVATIVE"
      ],
      "default": "MARKET_TYPE_UNSPECIFIED",
      "description": "- MARKET_TYPE_KOSPI: KOSPI\n - MARKET_TYPE_KOSDAQ: KOSDAQ\n - MARKET_TYPE_DERIVATIVE: 파생상품",
      "title": "시장 유형"
    },
    "protobufAny": {
      "type": "object",
      "properties": {
        "@type": {
          "type": "string"
        }
      },
      "additionalProperties": {}
    },
    "rpcStatus": {
      "type": "object",
      "properties": {
        "code": {
          "type": "integer",
          "format": "int32"
        },
        "message": {
          "type": "string"
        },
        "details": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/protobufAny"
          }
        }
      }
    },
    "stockGetStockTickSizeResponse": {
      "type": "object",
      "properties": {
        "tickSize": {
          "type": "string",
          "format": "int64",
          "title": "리소스 이름 (stocks/{code})"
        }
      }
    },
    "stockListStocksResponse": {
      "type": "object",
      "properties": {
        "stocks": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/stockStock"
          },
          "title": "주식 목록"
        },
        "nextPageToken": {
          "type": "string",
          "title": "다음 페이지 토큰"
        }
      }
    },
    "stockStock": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "title": "리소스 이름 (stocks/{code})"
        },
        "code": {
          "type": "string",
          "title": "종목 코드"
        },
        "symbol": {
          "type": "string",
          "title": "심볼"
        },
        "marketType": {
          "$ref": "#/definitions/commonMarketType",
          "title": "시장 유형"
        },
        "marketName": {
          "type": "string",
          "title": "종목명"
        },
        "prevPrice": {
          "type": "string",
          "format": "int64",
          "title": "전일 종가"
        },
        "lastPrice": {
          "type": "string",
          "format": "int64",
          "title": "최근 체결가"
        },
        "listedQuantity": {
          "type": "string",
          "format": "int64",
          "title": "상장 수량"
        },
        "tradable": {
          "type": "boolean",
          "title": "거래 가능 여부"
        },
        "shortSellable": {
          "type": "boolean",
          "title": "대차 가능 여부"
        },
        "tickSize": {
          "type": "string",
          "format": "int64",
          "title": "틱 크기"
        }
      },
      "title": "주식 종목 정보"
    }
  }
}
