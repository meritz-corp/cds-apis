    "/v1/premarket_order_reservations/{etfSymbol}/{fundCode}:start": {
      "post": {
        "summary": "장전 예약주문 시작 — 08:28 전이면 08:28 에, 08:28 ~ 08:59:55 면 바로 송신한다(08:30 이후 송신분은 바로 거래소 동시호가 접수).\n08:59:55 이후이거나 이미 실행 중이면 FAILED_PRECONDITION. 주문자 식별정보는 start 한 사람 기준.",
        "operationId": "PremarketOrderReservationService_StartPremarketOrderReservation",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
