    "/v1/premarket_order_reservations/{premarketOrderReservation.etfSymbol}/{premarketOrderReservation.fundCode}": {
      "post": {
        "summary": "장전 예약주문 저장 — 없으면 만들고 있으면 덮어쓴다. 오늘 실행 중인 (ETF, 펀드)는 바꿀 수 없다(FAILED_PRECONDITION).",
        "operationId": "PremarketOrderReservationService_UpdatePremarketOrderReservation",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/premarket_order_reservationPremarketOrderReservation"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "premarketOrderReservation.etfSymbol",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "premarketOrderReservation.fundCode",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "premarketOrderReservation": {
                  "type": "object",
                  "properties": {
                    "bidPrice": {
                      "type": "string",
                      "format": "int64",
                      "title": "매수 시작가(원). 0 이면 매수 안 냄"
                    },
                    "askPrice": {
                      "type": "string",
                      "format": "int64",
                      "title": "매도 시작가(원). 0 이면 매도 안 냄"
                    },
                    "depth": {
                      "type": "integer",
                      "format": "int64",
                      "title": "측별 단수 (1~10)"
                    },
                    "quantity": {
                      "type": "string",
                      "format": "int64",
                      "title": "단별 수량 (매수·매도 공통)"
                    },
                    "tickSize": {
                      "type": "string",
                      "format": "int64",
                      "title": "호가단위(원)"
                    },
                    "pricing": {
                      "$ref": "#/definitions/commonEtfPricing",
                      "description": "취소 기준가 = NAV(pricing·basis 로 계산) + adjustment ∓ offset 틱, 호가단위 맞춤 (ETF LP 1호가와 같은 식).\n매수가 \u003e 기준 매수가, 매도가 \u003c 기준 매도가면 취소한다."
                    },
                    "bidBasis": {
                      "type": "number",
                      "format": "double",
                      "title": "원"
                    },
                    "askBasis": {
                      "type": "number",
                      "format": "double",
                      "title": "원"
                    },
                    "bidAdjustment": {
                      "type": "number",
                      "format": "double",
                      "title": "원"
                    },
                    "askAdjustment": {
                      "type": "number",
                      "format": "double",
                      "title": "원"
                    },
                    "bidOffsetTicks": {
                      "type": "integer",
                      "format": "int32",
                      "title": "0 이상"
                    },
                    "askOffsetTicks": {
                      "type": "integer",
                      "format": "int32",
                      "title": "0 이상"
                    },
                    "updatedBy": {
                      "type": "string",
                      "title": "저장한 클라이언트 IP",
                      "readOnly": true
                    },
                    "updateTime": {
                      "type": "string",
                      "format": "date-time",
                      "readOnly": true
                    }
                  },
                  "title": "updated_by·update_time 은 무시(서버가 채움)"
                }
              }
            }
          }
        ],
        "tags": [
          "PremarketOrderReservationService"
        ]
      }
    }
