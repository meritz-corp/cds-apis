{
  "swagger": "2.0",
  "info": {
    "title": "kdo/v1/system.proto",
    "version": "version not set"
  },
  "tags": [
    {
      "name": "SystemService"
    }
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {},
  "definitions": {
    "protobufAny": {
      "type": "object",
      "properties": {
        "@type": {
          "type": "string"
        }
      },
      "additionalProperties": {}
    },
    "rpcStatus": {
      "type": "object",
      "properties": {
        "code": {
          "type": "integer",
          "format": "int32"
        },
        "message": {
          "type": "string"
        },
        "details": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/protobufAny"
          }
        }
      }
    },
    "systemCpuAffinityCore": {
      "type": "object",
      "properties": {
        "coreId": {
          "type": "integer",
          "format": "int64",
          "description": "CPU core id (0-indexed)."
        },
        "services": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/systemCpuAffinityService"
          },
          "description": "Services allocated on this core. Empty means free (main scheduler)."
        },
        "sharedCore": {
          "type": "boolean",
          "description": "True when this is the shared core of a tightening mode."
        },
        "poolKey": {
          "type": "string",
          "description": "yaml pool key that reserved this core. Empty when the core is not pool-reserved."
        }
      }
    },
    "systemCpuAffinityPool": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "description": "yaml pool key (etf_lp, mm, pair_v1 ...)."
        },
        "roles": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Roles covered by this key."
        },
        "reservedCores": {
          "type": "array",
          "items": {
            "type": "integer",
            "format": "int64"
          },
          "description": "Cores reserved for this pool."
        },
        "usedCores": {
          "type": "array",
          "items": {
            "type": "integer",
            "format": "int64"
          },
          "description": "Reserved cores that currently carry at least one instance."
        }
      }
    },
    "systemCpuAffinityService": {
      "type": "object",
      "properties": {
        "role": {
          "type": "string",
          "description": "Role name (QuoteLp, MarketMaking, MarketFeed, Pair, PairV2 ...)."
        },
        "thread": {
          "type": "string",
          "description": "Instance key: \"symbol:fund\" for LP/MM, pair id for pair, a thread label for single-instance roles."
        },
        "pinned": {
          "type": "boolean",
          "description": "True when a thread actually pinned itself to the core.\nFalse means the core is reserved but the thread has not started yet."
        },
        "unpinnedFallback": {
          "type": "boolean",
          "description": "True when the instance got no core and the operator confirmed starting it\nunpinned (it runs on the main scheduler). Distinguishes \"running unpinned by\noperator confirmation\" from \"start blocked, waiting for a core\"."
        }
      }
    },
    "systemFepClientInfo": {
      "type": "object",
      "properties": {
        "marketType": {
          "type": "string",
          "title": "\"Kospi\", \"Kosdaq\", \"Deriv\""
        },
        "exchangeType": {
          "type": "string",
          "title": "\"Krx\""
        },
        "clientType": {
          "type": "string",
          "title": "\"Submit\", \"Trade\""
        },
        "taskCode": {
          "type": "string",
          "title": "e.g., \"A831\", \"B851\""
        },
        "transportType": {
          "type": "string",
          "title": "\"tcp\", \"unix\""
        },
        "host": {
          "type": "string",
          "title": "IP address (for tcp) or empty (for unix)"
        },
        "port": {
          "type": "integer",
          "format": "int64",
          "title": "port number (for tcp) or 0 (for unix)"
        },
        "path": {
          "type": "string",
          "title": "unix socket path (for unix) or empty (for tcp)"
        },
        "hostname": {
          "type": "string",
          "title": "resolved hostname/alias (e.g., \"pfds11\", \"pfds14\")"
        }
      },
      "title": "Individual FEP client connection info"
    },
    "systemFepInfo": {
      "type": "object",
      "properties": {
        "implementation": {
          "type": "string",
          "title": "\"fake_memory\", \"fake_tcp\", \"tcp\""
        },
        "clients": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/systemFepClientInfo"
          },
          "title": "populated when implementation is \"tcp\""
        }
      },
      "title": "FEP connection info"
    },
    "systemGetConnectionInfoResponse": {
      "type": "object",
      "properties": {
        "krxMarketFeed": {
          "$ref": "#/definitions/systemMarketFeedInfo",
          "title": "Market feed connection info per exchange"
        },
        "nxtMarketFeed": {
          "$ref": "#/definitions/systemMarketFeedInfo",
          "title": "optional"
        },
        "fep": {
          "$ref": "#/definitions/systemFepInfo",
          "title": "FEP connection info"
        }
      }
    },
    "systemGetCpuAffinityResponse": {
      "type": "object",
      "properties": {
        "cpuCount": {
          "type": "integer",
          "format": "int64",
          "description": "Total CPU cores visible to the process."
        },
        "cores": {
          "type": "array",
          "items": {
            "type": "integer",
            "format": "int64"
          },
          "description": "Cores eligible for allocation (yaml cpu_affinity.cores), ascending."
        },
        "mode": {
          "type": "string",
          "description": "Allocation mode: \"easing\" | \"tightening_a\" | \"tightening_b\" | \"tightening_c\" | \"deep_tightening\"."
        },
        "coreAllocations": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/systemCpuAffinityCore"
          },
          "description": "Per-core view of every core in `cores`, including cores with nothing on them."
        },
        "pools": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/systemCpuAffinityPool"
          },
          "description": "Per-pool view (yaml cpu_affinity.pool): cores reserved for the pool vs cores actually in use."
        },
        "unpinnedRoles": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Roles with no CPU affinity (pool: 0, or not listed in pool) — they run on the main scheduler."
        },
        "unassigned": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/systemCpuAffinityService"
          },
          "description": "Instances that requested a core but got none (easing allocates 1 core per instance).\nEntries with unpinned_fallback = false cannot start until a core frees up or the pool\nis widened; entries with unpinned_fallback = true are running on the main scheduler\nbecause the operator confirmed starting them without a core."
        }
      }
    },
    "systemGetServerInfoResponse": {
      "type": "object",
      "properties": {
        "serverName": {
          "type": "string",
          "description": "Hostname identifying the running KDO instance."
        },
        "role": {
          "$ref": "#/definitions/userRole",
          "description": "Legacy single-role field. A single-role instance returns its role here and\nsupported_roles = [role]. A wildcard instance returns ROLE_UNSPECIFIED here.\nROLE_UNSPECIFIED never means that every role is supported."
        },
        "supportedRoles": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/userRole"
          },
          "description": "Trading roles supported by this instance. A wildcard (server.role = \"*\")\ninstance returns [ROLE_LP, ROLE_ARBITRAGE, ROLE_BROKERAGE, ROLE_LOAN].\nClients use this list when nonempty. If empty, clients may fall back to the\nlegacy role field, accepting only a concrete role (never ROLE_UNSPECIFIED)."
        }
      }
    },
    "systemGetVersionInfoResponse": {
      "type": "object",
      "properties": {
        "gitCommitHash": {
          "type": "string",
          "title": "Full git commit hash (e.g., \"33d5b91abc...\")"
        }
      }
    },
    "systemMarketFeedInfo": {
      "type": "object",
      "properties": {
        "implementation": {
          "type": "string",
          "title": "\"udp\", \"file\", \"websocket\", \"grpc\", \"simulation\""
        }
      },
      "title": "Market feed implementation info"
    },
    "systemStopAllTradingResponse": {
      "type": "object"
    },
    "systemStopSymbolFundResponse": {
      "type": "object",
      "properties": {
        "stopped": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/systemStoppedService"
          }
        }
      }
    },
    "systemStoppedService": {
      "type": "object",
      "properties": {
        "service": {
          "type": "string",
          "title": "\"quote\" | \"mm\" | \"mm_v2\" | \"futures_lp\" | \"pair\""
        },
        "identifier": {
          "type": "string",
          "title": "\"symbol/fund\" 또는 pair_id"
        },
        "message": {
          "type": "string"
        }
      }
    },
    "userRole": {
      "type": "string",
      "enum": [
        "ROLE_UNSPECIFIED",
        "ROLE_LP",
        "ROLE_ARBITRAGE",
        "ROLE_BROKERAGE",
        "ROLE_LOAN"
      ],
      "default": "ROLE_UNSPECIFIED",
      "description": "Role represents the trading role assigned to a user."
    }
  }
}
