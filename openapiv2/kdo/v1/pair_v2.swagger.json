    "/v1/{pairV2}:amendResidualPct": {
      "post": {
        "summary": "미체결 잔량 정정 - 현재가 대비 ±amend_pct% 공격적 가격으로 일괄 정정 (mmm \"미체결 1% 정정\" 대응).\n정정된 주문은 auto_amend 자동 추적에서 해제된다 (운영자 수동 개입 시맨틱).",
        "operationId": "PairV2Service_AmendPairV2ResidualPct",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/pair_v2AmendPairV2ResidualPctResponse"
