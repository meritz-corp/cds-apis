        },
        "nextPageToken": {
          "type": "string",
          "title": "다음 페이지 토큰 (더 없으면 빈 문자열)"
        },
        "totalCount": {
          "type": "integer",
          "format": "int32",
          "title": "필터 조건(outcome/dispatched_from/dispatched_to) 기준 전체 건수 (cursor 무관)"
        }
      }
