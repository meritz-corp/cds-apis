    "/v1/{pairV2}:launchOnce": {
      "post": {
        "summary": "수동 1회 발사 - 스프레드 조건/쿨다운/중지회차를 무시하고 즉시 양다리 1회 발사를 큐잉.\nPAUSED 상태에서도 허용하며 자동발주를 켜지 않는다. 중복 대기 요청은 FAILED_PRECONDITION.\n시세 유효성(양다리 5초 이내), 연속매매, 수량 상한, 주문/잔고 검증은 유지한다.\n대기 요청은 5초 뒤 만료된다. accepted는 접수이고 결과는 실행로그/상태 스트림에서 확인한다.",
        "operationId": "PairV2Service_LaunchPairV2Once",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/pair_v2LaunchPairV2OnceResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "pairV2",
            "description": "리소스 이름 (pair_v2s/{id})",
            "in": "path",
            "required": true,
            "type": "string",
            "pattern": "pairV2s/[^/]+"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object"
            }
          }
        ],
        "tags": [
          "PairV2Service"
        ]
      }
    },
    "/v1/{pairV2}:pause": {
      "post": {
        "summary": "PairV2 일시 중지 (hot loop 중지, status → PAUSED)",
        "operationId": "PairV2Service_PausePairV2",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/pair_v2PairV2"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "pairV2",
            "description": "리소스 이름 (pair_v2s/{id})",
            "in": "path",
            "required": true,
            "type": "string",
            "pattern": "pairV2s/[^/]+"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object"
            }
          }
        ],
        "tags": [
          "PairV2Service"
        ]
      }
    },
    "/v1/{pairV2}:resetSession": {
      "post": {
        "summary": "명시적인 새 실행 시작 준비. PAUSED이고 미체결이 없을 때만 회차/누적 실행 상태 초기화.\n설정 수정, 일시정지, 재활성화는 실행 상태를 유지한다. 초기화 자체는 자동발주를 켜지 않는다.",
        "operationId": "PairV2Service_ResetPairV2Session",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/pair_v2PairV2"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "pairV2",
            "in": "path",
            "required": true,
            "type": "string",
            "pattern": "pairV2s/[^/]+"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object"
            }
          }
        ],
        "tags": [
          "PairV2Service"
        ]
      }
    },
    "/v1/{pairV2}:streamStatus": {
      "get": {
        "summary": "PairV2 실시간 운영 단계(phase) 스트리밍 (변경 시마다 emit)",
        "operationId": "PairV2Service_StreamPairV2Status",
        "responses": {
          "200": {
            "description": "A successful response.(streaming responses)",
            "schema": {
              "type": "object",
              "properties": {
                "result": {
                  "$ref": "#/definitions/pair_v2PairV2StatusUpdate"
                },
                "error": {
                  "$ref": "#/definitions/rpcStatus"
                }
              },
              "title": "Stream result of pair_v2PairV2StatusUpdate"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "pairV2",
            "description": "리소스 이름 (pair_v2s/{id})",
            "in": "path",
            "required": true,
            "type": "string",
            "pattern": "pairV2s/[^/]+"
          }
        ],
        "tags": [
          "PairV2Service"
        ]
      }
    }
  },
  "definitions": {
    "commonOrderSide": {
      "type": "string",
      "enum": [
        "ORDER_SIDE_UNSPECIFIED",
        "ORDER_SIDE_BID",
        "ORDER_SIDE_ASK"
      ],
      "default": "ORDER_SIDE_UNSPECIFIED",
      "description": "- ORDER_SIDE_BID: 매수\n - ORDER_SIDE_ASK: 매도",
      "title": "주문 방향"
    },
    "commonRelativePriceSource": {
      "type": "string",
      "enum": [
        "RELATIVE_PRICE_SOURCE_UNSPECIFIED",
        "RELATIVE_PRICE_SOURCE_BEST_MAKE",
        "RELATIVE_PRICE_SOURCE_BEST_TAKE"
      ],
      "default": "RELATIVE_PRICE_SOURCE_UNSPECIFIED",
      "description": "참조 가격 소스 — entry(주문) 의 side 기준 자기/상대 호가. 절대 위치(Bid1/Ask1/MidPrice 등)를\n나타내는 kdo.v1.basket.PriceSource 와 달리 side 에 상대적이므로 혼동 방지를 위해 이름을\nRelativePriceSource 로 구분한다. kdo.v1.pair.PriceSource 와 동일한 의미.\n\n - RELATIVE_PRICE_SOURCE_BEST_MAKE: 자기호가 (entry.side 와 같은 방향의 1호가). Bid 주문 → bid1, Ask 주문 → ask1.\n - RELATIVE_PRICE_SOURCE_BEST_TAKE: 상대호가 (entry.side 반대 방향의 1호가). Bid 주문 → ask1, Ask 주문 → bid1."
    },
    "hedgeOrderTpCode": {
      "type": "string",
      "enum": [
        "ORDER_TP_CODE_UNSPECIFIED",
        "ORDER_TP_CODE_NONE",
        "ORDER_TP_CODE_LP"
      ],
      "default": "ORDER_TP_CODE_UNSPECIFIED",
      "description": "- ORDER_TP_CODE_UNSPECIFIED: 미지정 (도메인에서 None으로 매핑)\n - ORDER_TP_CODE_NONE: 일반 주문\n - ORDER_TP_CODE_LP: LP 주문",
      "title": "헷지 주문 TP 코드 (호가 구분)"
    },
    "pair_v2AmendPairV2ResidualPctResponse": {
      "type": "object",
      "properties": {
        "amendedOrders": {
          "type": "array",
          "items": {
