        },
        "triggerToBaseSubmitUs": {
          "type": "string",
          "format": "int64",
          "description": "트리거 시세 수신 시점부터 base 제출 직후까지 경과 (us). 미발주 0."
        },
        "triggerToCounterSubmitUs": {
          "type": "string",
          "format": "int64",
          "description": "트리거 시세 수신 시점부터 counter 제출 직후까지 경과 (us). 미발주 0."
        },
