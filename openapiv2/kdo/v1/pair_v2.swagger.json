          "items": {
            "$ref": "#/definitions/pair_v2PairV2ResidualError"
          },
          "title": "정정 실패/스킵 항목"
        }
      }
    },
    "pair_v2CancelPairV2ResidualResponse": {
      "type": "object",
      "properties": {
        "cancelledOrderIds": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uint64"
          },
          "title": "취소 요청된 원주문 ID 목록"
        },
        "errors": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/pair_v2PairV2ResidualError"
          },
          "title": "취소 실패 항목 (주문ID: 사유)"
        }
      }
    },
    "pair_v2GetPairV2OrderSummaryResponse": {
      "type": "object",
      "properties": {
        "legs": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/pair_v2PairV2LegSummary"
          }
        },
        "launchCount": {
          "type": "integer",
          "format": "int64",
          "title": "세션 발사 횟수 (실행 중 아니면 0)"
        }
      }
    },
    "pair_v2LaunchPairV2OnceResponse": {
      "type": "object",
      "properties": {
        "accepted": {
          "type": "boolean",
          "title": "발사 큐잉 성공 여부 (실제 발주는 핫루프 다음 tick 에서 실행)"
        },
        "reason": {
          "type": "string",
          "title": "거부 사유 (accepted=false 일 때)"
        }
      }
    },
    "pair_v2ListPairV2ExecutionLogsResponse": {
      "type": "object",
      "properties": {
        "executionLogs": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/pair_v2PairV2ExecutionLog"
          },
