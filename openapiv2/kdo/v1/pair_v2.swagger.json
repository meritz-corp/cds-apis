    "pair_v2ListPairV2sResponse": {
      "type": "object",
      "properties": {
        "pairV2s": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/pair_v2PairV2"
          },
          "title": "PairV2 목록"
        },
        "nextPageToken": {
          "type": "string",
          "title": "다음 페이지 토큰"
        }
      }
    },
    "pair_v2PairV2": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "title": "리소스 이름 (pair_v2s/{id})"
        },
        "id": {
          "type": "integer",
          "format": "int32",
          "title": "PairV2 ID",
          "readOnly": true
        },
        "displayName": {
          "type": "string",
          "title": "전략 이름 (고유)"
        },
        "portfolioId": {
          "type": "integer",
          "format": "int32",
          "title": "Portfolio ID"
        },
        "base": {
          "$ref": "#/definitions/pair_v2PairV2Entry",
          "description": "Base 다리. side 가 매수차(BID)/매도차(ASK) 를 결정하고, quantity 가 1회 발주량."
        },
        "counter": {
          "$ref": "#/definitions/pair_v2PairV2Entry",
          "description": "Counter 다리. quantity는 명시적인 1회 발주량으로 그대로 사용한다."
        },
        "spread": {
          "$ref": "#/definitions/pair_v2PairV2SpreadType",
          "description": "counter 가격을 base 가격축으로 옮기는 방법."
        },
        "targetSpread": {
          "type": "number",
          "format": "double",
          "description": "진입 최소 스프레드. 현재 스프레드가 이 값을 \"초과\"할 때 발사. 단위 = base 가격 단위.\n캘린더 스프레드처럼 즉시 차익이 아닌 운용은 음수가 정상이다."
        },
        "cooldownMs": {
          "type": "string",
          "format": "uint64",
          "title": "발사 후 재발사까지 대기 (ms)"
        },
        "amendThreshold": {
          "type": "number",
          "format": "double",
          "description": "미체결 잔량 추적 정정 임계 — auto_amend SelfQuote 의 opposite_qty_ratio_threshold.\nbase/counter 공유. 0 이면 절대 정정하지 않아 미체결이 영구히 남으므로 양수 필수."
        },
        "nav": {
          "$ref": "#/definitions/pair_v2PairV2Nav",
          "description": "spread 가 NAV 일 때 필수인 NAV 환산 설정."
        },
        "maxBaseQuantity": {
          "type": "string",
          "format": "int64",
          "description": "base 다리 누적 상한 — 체결 + 미체결(inflight) 합산. 도달 시 신규 발사를 막는다."
        },
        "status": {
          "$ref": "#/definitions/pair_v2PairV2Status",
          "title": "상태",
          "readOnly": true
        },
        "createTime": {
          "type": "string",
          "format": "date-time",
          "title": "생성 시간",
          "readOnly": true
        },
        "updateTime": {
          "type": "string",
          "format": "date-time",
          "title": "수정 시간",
          "readOnly": true
        },
        "pauseLaunchNo": {
          "type": "integer",
          "format": "int64",
          "description": "중지회차 - 이번 실행 세션의 발사 횟수가 이 값에 도달하면 자동 발사를 중지 (미설정 = 제한 없음).\n수동 발사도 횟수에 포함되지만 이 게이트는 무시한다. base 제출 성공 기준으로 센다.\n설정 변경/Pause/Activate 시 유지. ResetPairV2Session으로 초기화한다 (서버 프로세스 내 세션)."
        },
        "tradingWindowStart": {
          "type": "string",
          "description": "자동 발사 운영 시간창 시작 (KST \"HH:MM:SS\", 미설정 = 상시).\n시간창 밖에서는 자동 발사만 중지되고 수동 발사(LaunchPairV2Once)는 허용된다.\nstart \u003e end 이면 자정을 넘기는 창으로 해석한다 (예: 18:00:00 ~ 02:00:00)."
        },
        "tradingWindowEnd": {
          "type": "string",
          "title": "자동 발사 운영 시간창 종료 (KST \"HH:MM:SS\", 미설정 = 상시)"
        },
        "slippageGuard": {
          "type": "boolean",
          "description": "슬리피지 가드 - true 면 양다리의 발주 호가(BEST_TAKE=상대, BEST_MAKE=자기) 잔량이 발주수량 이상일 때만\n자동 발사한다 (잔량 부족 = 즉시 체결 불가/슬리피지 위험 → 발사 보류).\n수동 발사(LaunchPairV2Once)는 가드를 무시한다. 기본 false."
        },
        "allowBorrowedSell": {
          "type": "boolean",
          "description": "일반 매도 가능 수량 부족 시 차입 재고 사용 허용. 기본 false.\n수동/자동 모두 적용하며, 체크와 예약은 동일 잔고 잠금 아래 수행한다."
        },
        "minFillRatePct": {
          "type": "number",
          "format": "double",
          "description": "이전 회차 양다리 체결률의 최솟값 \u003e= 설정값일 때 다음 자동 발사 허용.\n0..100, 미설정=제한 없음, 첫 회차=통과. 수동 발사는 무시한다.\n분모는 해당 회차 최초 발주수량. 정정은 중복 집계하지 않고 취소/거부는 체결로 세지 않는다."
        }
      },
      "description": "PairV2 전략 — base·counter 지정 호가로 재는 스프레드가 target_spread 를 초과하면\n그 가격 그대로 양다리를 동시 발주한다.",
      "required": [
        "displayName",
        "portfolioId",
        "base",
        "counter",
        "spread"
      ]
    },
    "pair_v2PairV2AmendedOrder": {
      "type": "object",
      "properties": {
        "originalOrderId": {
          "type": "string",
          "format": "uint64",
          "title": "원주문 ID"
        },
        "amendOrderId": {
          "type": "string",
          "format": "uint64",
          "title": "정정 주문 ID"
        },
        "price": {
          "type": "string",
          "title": "정정 후 가격"
        }
      },
      "title": "정정된 주문"
    },
    "pair_v2PairV2BlockReason": {
      "type": "string",
      "enum": [
        "PAIR_V2_BLOCK_REASON_UNSPECIFIED",
        "PAIR_V2_BLOCK_REASON_NONE",
        "PAIR_V2_BLOCK_REASON_PAUSED",
        "PAIR_V2_BLOCK_REASON_PRICE_UNAVAILABLE",
        "PAIR_V2_BLOCK_REASON_STALE_QUOTE",
        "PAIR_V2_BLOCK_REASON_NON_CONTINUOUS_SESSION",
        "PAIR_V2_BLOCK_REASON_SPREAD",
        "PAIR_V2_BLOCK_REASON_COOLDOWN",
        "PAIR_V2_BLOCK_REASON_TRADING_WINDOW",
        "PAIR_V2_BLOCK_REASON_LAUNCH_LIMIT",
        "PAIR_V2_BLOCK_REASON_FILL_RATE",
        "PAIR_V2_BLOCK_REASON_SLIPPAGE",
        "PAIR_V2_BLOCK_REASON_QUANTITY_LIMIT",
        "PAIR_V2_BLOCK_REASON_ORDER_VALIDATION",
        "PAIR_V2_BLOCK_REASON_PARTIAL_FAILURE",
        "PAIR_V2_BLOCK_REASON_RUNTIME_ERROR"
      ],
      "default": "PAIR_V2_BLOCK_REASON_UNSPECIFIED"
    },
    "pair_v2PairV2Entry": {
      "type": "object",
      "properties": {
        "symbol": {
          "type": "string",
          "title": "종목 심볼"
        },
        "fundCode": {
          "type": "string",
          "title": "주문에 사용할 펀드 코드"
        },
        "side": {
          "$ref": "#/definitions/commonOrderSide",
          "title": "주문 방향 (base.side 가 스프레드 부호 규약의 기준)"
        },
        "quantity": {
          "type": "string",
          "format": "int64",
          "description": "주문 수량. base/counter 모두 명시적인 1회 발주량."
        },
        "priceSource": {
          "$ref": "#/definitions/commonRelativePriceSource",
          "description": "호가 위치 — 스프레드 측정 기준이자 발주 가격. 미지정(UNSPECIFIED) 시 도메인 기본값\nBEST_TAKE(상대호가, 즉시 체결 지향)로 처리된다."
        },
        "tpCode": {
          "$ref": "#/definitions/hedgeOrderTpCode",
          "description": "주문 tp_code (NONE=일반, LP=유동성공급자). 정정/취소는 거래소가 원주문 tp_code 를 따른다."
        }
      },
      "description": "페어의 한쪽 엔트리 (단일 심볼 주문 스펙).\n\nv1 과 달리 base·counter 두 다리 모두 price_source 가 유효하다 — 스프레드를 그 가격으로\n재고 그 가격으로 발주한다(측정가 = 발주가 불변식).",
      "required": [
        "symbol",
        "fundCode",
        "side",
        "quantity"
      ]
    },
    "pair_v2PairV2ExecutionLog": {
      "type": "object",
      "properties": {
        "pairId": {
          "type": "integer",
          "format": "int32",
          "title": "Pair ID"
        },
        "outcome": {
          "$ref": "#/definitions/pair_v2PairV2ExecutionOutcome",
          "title": "실행 결과"
        },
        "spread": {
          "type": "number",
          "format": "double",
          "title": "발사 판정에 쓴 측정 스프레드 (base 가격 단위)"
        },
        "targetSpread": {
          "type": "number",
          "format": "double",
          "title": "그 시점의 목표 스프레드 (설정 변경 이력 추적용)"
        },
        "baseOrderId": {
          "type": "string",
          "format": "uint64",
