  "definitions": {
    "commonOrderSide": {
      "type": "string",
      "enum": [
        "ORDER_SIDE_UNSPECIFIED",
        "ORDER_SIDE_BID",
        "ORDER_SIDE_ASK"
      ],
      "default": "ORDER_SIDE_UNSPECIFIED",
      "description": "- ORDER_SIDE_BID: 매수\n - ORDER_SIDE_ASK: 매도",
      "title": "주문 방향"
    },
    "commonRelativePriceSource": {
      "type": "string",
      "enum": [
        "RELATIVE_PRICE_SOURCE_UNSPECIFIED",
        "RELATIVE_PRICE_SOURCE_BEST_MAKE",
        "RELATIVE_PRICE_SOURCE_BEST_TAKE"
      ],
      "default": "RELATIVE_PRICE_SOURCE_UNSPECIFIED",
      "description": "참조 가격 소스 — entry(주문) 의 side 기준 자기/상대 호가. 절대 위치(Bid1/Ask1/MidPrice 등)를\n나타내는 kdo.v1.basket.PriceSource 와 달리 side 에 상대적이므로 혼동 방지를 위해 이름을\nRelativePriceSource 로 구분한다. kdo.v1.pair.PriceSource 와 동일한 의미.\n\n - RELATIVE_PRICE_SOURCE_BEST_MAKE: 자기호가 (entry.side 와 같은 방향의 1호가). Bid 주문 → bid1, Ask 주문 → ask1.\n - RELATIVE_PRICE_SOURCE_BEST_TAKE: 상대호가 (entry.side 반대 방향의 1호가). Bid 주문 → ask1, Ask 주문 → bid1."
    },
    "hedgeOrderTpCode": {
      "type": "string",
      "enum": [
        "ORDER_TP_CODE_UNSPECIFIED",
        "ORDER_TP_CODE_NONE",
        "ORDER_TP_CODE_LP"
      ],
      "default": "ORDER_TP_CODE_UNSPECIFIED",
      "description": "- ORDER_TP_CODE_UNSPECIFIED: 미지정 (도메인에서 None으로 매핑)\n - ORDER_TP_CODE_NONE: 일반 주문\n - ORDER_TP_CODE_LP: LP 주문",
      "title": "헷지 주문 TP 코드 (호가 구분)"
    },
    "pair_v2ListPairV2ExecutionLogsResponse": {
      "type": "object",
      "properties": {
