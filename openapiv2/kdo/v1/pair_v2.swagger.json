              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "pairV2",
            "description": "리소스 이름 (pair_v2s/{id})",
            "in": "path",
            "required": true,
            "type": "string",
            "pattern": "pairV2s/[^/]+"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "amendPct": {
                  "type": "number",
                  "format": "double",
                  "description": "정정 폭 % (예: 1.0 = 현재가 대비 1%). 0 \u003c amend_pct \u003c= 30.\n매도 주문은 현재가×(1-pct/100), 매수 주문은 ×(1+pct/100) 방향. 기존 주문가보다 공격적일 때만 정정."
                }
              },
              "required": [
                "amendPct"
              ]
            }
          }
        ],
        "tags": [
          "PairV2Service"
        ]
      }
    },
