    "/v1/{pairV2}/executionLogs": {
      "get": {
        "summary": "PairV2 실행 로그 목록 조회 (발사/스킵 시점 스냅샷, 페이징)",
        "operationId": "PairV2Service_ListPairV2ExecutionLogs",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/pair_v2ListPairV2ExecutionLogsResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "pairV2",
            "description": "리소스 이름 (pair_v2s/{id})",
            "in": "path",
            "required": true,
            "type": "string",
            "pattern": "pairV2s/[^/]+"
          },
          {
            "name": "pageSize",
            "description": "페이지 크기 (기본: 50, 최대: 200)",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int32"
          },
          {
            "name": "pageToken",
            "description": "페이지 토큰 — 최신순(id DESC) 키셋 커서. 이전 응답의 next_page_token 을 그대로 전달.\n최초 조회는 미지정.",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "outcome",
            "description": "outcome 필터 (UNSPECIFIED = 전체)\n\n - PAIR_V2_EXECUTION_OUTCOME_SUBMITTED: 양 다리 모두 제출 성공\n - PAIR_V2_EXECUTION_OUTCOME_SKIPPED_COOLDOWN: 쿨다운 미충족\n - PAIR_V2_EXECUTION_OUTCOME_SKIPPED_MAX_QUANTITY: base 누적(체결+미체결)이 max_base_quantity 도달\n - PAIR_V2_EXECUTION_OUTCOME_SKIPPED_PRICE_UNAVAILABLE: 한쪽 호가 미형성 등으로 스프레드 산출 불가\n - PAIR_V2_EXECUTION_OUTCOME_PARTIAL_FAILURE: 한 다리만 제출 성공 — 반대 다리 없이 노출이 남는다\n - PAIR_V2_EXECUTION_OUTCOME_FAILED: 양 다리 모두 제출 실패",
            "in": "query",
            "required": false,
            "type": "string",
            "enum": [
              "PAIR_V2_EXECUTION_OUTCOME_UNSPECIFIED",
              "PAIR_V2_EXECUTION_OUTCOME_SUBMITTED",
              "PAIR_V2_EXECUTION_OUTCOME_SKIPPED_COOLDOWN",
              "PAIR_V2_EXECUTION_OUTCOME_SKIPPED_MAX_QUANTITY",
              "PAIR_V2_EXECUTION_OUTCOME_SKIPPED_PRICE_UNAVAILABLE",
              "PAIR_V2_EXECUTION_OUTCOME_PARTIAL_FAILURE",
              "PAIR_V2_EXECUTION_OUTCOME_FAILED"
            ],
            "default": "PAIR_V2_EXECUTION_OUTCOME_UNSPECIFIED"
          },
          {
            "name": "dispatchedFrom",
            "description": "발주 시각 범위 시작 (inclusive). 미지정 시 하한 없음.",
            "in": "query",
            "required": false,
            "type": "string",
            "format": "date-time"
          },
          {
            "name": "dispatchedTo",
            "description": "발주 시각 범위 끝 (exclusive). 미지정 시 상한 없음.",
            "in": "query",
            "required": false,
            "type": "string",
            "format": "date-time"
          }
        ],
        "tags": [
          "PairV2Service"
        ]
      }
    },
