  "paths": {
    "/v1/pair_v2s": {
      "get": {
        "summary": "PairV2 목록 조회 (페이징 + 필터)",
        "operationId": "PairV2Service_ListPairV2s",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/pair_v2ListPairV2sResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "pageSize",
            "description": "페이지 크기 (optional)",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int32"
          },
          {
            "name": "pageToken",
            "description": "페이지 토큰 (optional, for pagination)",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "filter",
            "description": "필터링 조건 (optional, AIP-160)\n\nAvailable Fields:\n* status - 상태 (ACTIVE / PAUSED / ARCHIVED)\n* portfolio_id - Portfolio ID\n\nExamples:\n* status=ACTIVE\n* portfolio_id=1",
            "in": "query",
            "required": false,
            "type": "string"
          }
        ],
        "tags": [
          "PairV2Service"
        ]
      },
